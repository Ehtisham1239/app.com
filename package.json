{
  "name": "online-quran-college",
  "version": "2.0.0",
  "private": true,
  "description": "Online Quran College \u2014 public website and admin panel (Next.js + Supabase).",
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-responsive-learning.mjs && next dev",
    "prebuild": "node scripts/prepare-production-build.mjs",
    "build": "node scripts/prepare-responsive-learning.mjs && next build",
    "postbuild": "node scripts/verify-build-assets.mjs",
    "start": "next start",
    "lint": "eslint .",
    "test": "node scripts/prepare-responsive-learning.mjs && node --test tests/*.test.mjs",
    "seed:locations": "node scripts/seed-locations.mjs",
    "test:browser": "node scripts/browser-smoke.mjs",
    "verify:site": "node scripts/run-site-quality.mjs",
    "db:bundle": "node scripts/bundle-database.mjs",
    "seed:snapshot": "node scripts/export-seed-content.mjs",
    "seo:agent": "node scripts/seo-agent-audit.mjs",
    "seo:keywords": "node scripts/keyword-coverage.mjs",
    "seo:search-engines": "node scripts/search-engine-audit.mjs",
    "seo:notify": "node scripts/indexnow.mjs",
    "test:admin-data": "node scripts/admin-data-smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource/amiri": "5.3.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@tiptap/pm": "3.31.4",
    "@tiptap/react": "3.31.4",
    "@tiptap/starter-kit": "3.31.4",
    "@vercel/speed-insights": "2.0.0",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "luxon": "3.7.2",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.18.1",
    "sharp": "0.35.5",
    "sonner": "2.0.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@tailwindcss/postcss": "4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "playwright": "1.64.1",
    "tailwindcss": "4.3.3"
  },
  "overrides": {
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.6"
    }
  }
}
