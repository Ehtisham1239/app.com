NEXT_PUBLIC_SUPABASE_URL=https://lgbwidraztavhhbnbfhr.supabase.co
# Copy this project's PUBLIC publishable key from Supabase Settings > API.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://www.onlinequrancollege.com

# USA landing page admissions email (server-only; never prefix with NEXT_PUBLIC_).
# Resend API key with "Sending access" only, from resend.com > API Keys.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "OQC Website <leads@onlinequrancollege.com>".
LEAD_NOTIFICATION_FROM=
# Internal recipients, comma-separated (up to 50).
LEAD_NOTIFICATION_TO=

# Server-side lookup for website contact, trial and review notifications.
SUPABASE_SERVICE_ROLE_KEY=

# HighLevel admissions connector (server-only). Use the intended sub-account
# location ID and a private integration token scoped to contacts.write.
GHL_LOCATION_ID=
GHL_PRIVATE_INTEGRATION_TOKEN=
# Enable after verifying duplicate matching and any workflows in the target CRM.
GHL_ADMISSIONS_SYNC=false
# Set both IDs to route new admissions opportunities into an existing pipeline.
# The token also needs opportunities.readonly and opportunities.write.
GHL_ADMISSIONS_PIPELINE_ID=
GHL_ADMISSIONS_STAGE_ID=
